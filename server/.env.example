# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/rag-knowledge-assistant

# JWT Secrets (min 32 characters each — use strong random strings in production)
JWT_SECRET=your_super_long_jwt_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_super_long_refresh_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server Port
PORT=5000
NODE_ENV=development

# Rate Limits (per user per day)
CHAT_DAILY_LIMIT=20
UPLOAD_DAILY_LIMIT=20
MAX_FILE_SIZE_MB=20

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STREAM_MODEL=openai/gpt-3.5-turbo

# Gemini API (Optional - for fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API (Optional - for fallback)
HF_API_KEY=your_huggingface_api_key_here

# Groq API (Optional - streaming fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_STREAM_MODEL=llama-3.3-70b-versatile

# Frontend URL (for CORS)
CLIENT_URL=https://rag-knowledge-assistant-omega.vercel.app
