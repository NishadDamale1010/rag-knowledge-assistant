# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/rag-knowledge-assistant

# JWT Secrets (min 32 characters each — use strong random strings in production)
JWT_SECRET=your_super_long_jwt_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_super_long_refresh_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server Port
PORT=5000
NODE_ENV=development

# Rate Limits (per user per day)
CHAT_DAILY_LIMIT=20
UPLOAD_DAILY_LIMIT=20
MAX_FILE_SIZE_MB=20

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_STREAM_MODEL=openrouter/free
# Optional comma-separated overrides. The app also discovers current free models automatically.
OPENROUTER_MODEL_FALLBACKS=
OPENROUTER_MODEL_DISCOVERY_DISABLED=false
LLM_REQUEST_TIMEOUT_MS=30000

# Gemini API (Optional - for fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-1.5-flash

# HuggingFace API (Optional - for fallback)
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL_FALLBACKS=mistralai/Mistral-7B-Instruct-v0.1,HuggingFaceH4/zephyr-7b-beta,google/flan-t5-large

# Groq API (Optional - streaming fallback)
# Check https://console.groq.com/docs/deprecations for current model availability
GROQ_API_KEY=your_groq_api_key_here
GROQ_STREAM_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it

# Frontend URL (for CORS)
CLIENT_URL=https://rag-knowledge-assistant-omega.vercel.app
