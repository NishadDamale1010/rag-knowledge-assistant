# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/rag-knowledge-assistant

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Server Port
PORT=5000

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: override streaming model (default: openai/gpt-3.5-turbo)
OPENROUTER_STREAM_MODEL=openai/gpt-3.5-turbo

# Gemini API (Optional - for fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API (Optional - for fallback)
HF_API_KEY=your_huggingface_api_key_here

# Groq API (Optional - streaming fallback)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override Groq streaming model (default: llama-3.1-70b-versatile)
GROQ_STREAM_MODEL=llama-3.1-70b-versatile

# Node Environment
NODE_ENV=development
